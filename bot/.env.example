# Copy to .env for local development. Never commit the real file.
# The bot shares the database and the money rules with the API, so these values MUST match
# the API service (especially ENCRYPTION_KEY — a different key makes credentials unreadable).

NODE_ENV=development
# Render injects PORT itself; this is for local runs only.
PORT=3002

MONGODB_URI=mongodb://localhost:27017/bitmax
BOT_TOKEN=
ADMIN_CHAT_ID=
ADMIN_IDS=
BOT_USERNAME=bitmax_bot
SUPPORT_USERNAME=bitmax_admin
SITE_URL=https://web-three-eosin-46.vercel.app

# Same value as the API service. Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Money rules (same values as the API)
PLATFORM_COMMISSION=7
PAYMENT_WINDOW_MINUTES=10
AUTO_RELEASE_HOURS=24
UNREVEALED_GRACE_HOURS=72
MIN_PAYOUT_AMOUNT=10000
PAYOUT_FEE_FLAT=0
REFUND_ABUSE_THRESHOLD=3
CREDENTIAL_RETENTION_DAYS=30
MAX_PRODUCT_IMAGES=8

# Payments: the bot opens purchases, so it needs the same provider settings as the API.
PAYMENT_PROVIDER=hamyon
PAYMENT_CARDS=[]
HAMYON_BASE_URL=https://hamyon-api.uz
HAMYON_SHOP_ID=
HAMYON_SHOP_KEY=

# Photo uploads from sellers
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Webhook mode (production). On Render this is derived from RENDER_EXTERNAL_URL automatically.
# Leave empty locally to use long polling.
BOT_WEBHOOK_URL=

# Must stay false in production (the API refuses to boot otherwise).
ALLOW_SELF_PURCHASE=false

# Shared with the API (the bot opens payments itself, so these must match it).
DEMO_PAYMENTS=false
TEST_AUTO_CONFIRM_ADMIN=false
PAYOUT_CARD_COOLDOWN_HOURS=24
HAMYON_MAX_AMOUNT_OFFSET=30
